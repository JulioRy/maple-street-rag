OPENAI_API_KEY=your-openai-api-key-here

# Optional: use Google Gemini instead (free key at https://aistudio.google.com/apikey,
# but the free tier allows only 20 chat requests per day, less than one eval run)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides (defaults shown; models default per provider)
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# PORT=3000
# MODEL_TIMEOUT_MS=20000
# RETRIEVAL_K=8
# DOCS_DIR=docs

# Used by `npm run eval`
# EVAL_BASE_URL=http://localhost:3000
# EVAL_CONCURRENCY=4
